# ============================================================================
# Incubein backend — environment template (copy to `backend/.env`)
#   cp backend/.env.example backend/.env
# ============================================================================

# AI providers
OPENROUTER_API_KEY=
GoogleCalender=
GEMINI_API_KEY=

# SMTP mailer (sender #1)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# SMTP mailer (sender #2)
SMTP_HOST1=smtp.gmail.com
SMTP_PORT1=587
SMTP_USER1=
SMTP_PASS1=

# IMAP reply scanner
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=

IMAP_HOST1=imap.gmail.com
IMAP_PORT1=993
IMAP_USER1=
IMAP_PASS1=

# MongoDB (Atlas by default; self-hosted -> mongodb://mongo:27017/)
MONGO_URI=mongodb+srv://USER:PASS@CLUSTER.mongodb.net/?appName=Incubein

# Google OAuth 2.0 (Google Meet scheduling)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/outreach/oauth2callback

# Encryption key for sensitive fields
ENCRYPTION_KEY=

# Redis (docker compose overrides this to the `redis` service)
REDIS_URL=redis://localhost:6379/0
