# ============================================================================
# Incubein Platform — production environment template
# ============================================================================
# Copy to `.env` (deployment-level vars used by docker-compose) and ensure
# `backend/.env` holds the application secrets (SMTP/IMAP/Google/Mongo/keys).
#
#   cp .env.example .env
#   cp backend/.env.example backend/.env    # then fill in real secrets
#   docker compose up -d --build
# ============================================================================

# ---------------------------------------------------------------------------
# Deployment-level (read by docker-compose)
# ---------------------------------------------------------------------------

# Host port exposed to the internet. Put this behind a TLS-terminating
# reverse proxy (nginx/caddy/Traefik/cloud LB) in real production.
PORT=80

# Optional Redis password. When set, the backend connects using it.
REDIS_PASSWORD=

# ---------------------------------------------------------------------------
# Application secrets (mirror the keys in backend/.env)
# ---------------------------------------------------------------------------

# OpenRouter API Key (AI Assistant fallback models)
OPENROUTER_API_KEY=

# Google Calendar API key
GoogleCalender=

# Google Gemini API key (AI enrichment)
GEMINI_API_KEY=

# SMTP (sender #1) — Gmail app password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# SMTP (sender #2)
SMTP_HOST1=smtp.gmail.com
SMTP_PORT1=587
SMTP_USER1=
SMTP_PASS1=

# IMAP (reply scanner)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=

IMAP_HOST1=imap.gmail.com
IMAP_PORT1=993
IMAP_USER1=
IMAP_PASS1=

# MongoDB connection string. Keep the Atlas URI, or point at the self-hosted
# `mongo` service (see docker-compose.yml) with mongodb://mongo:27017/
MONGO_URI=mongodb+srv://USER:PASS@CLUSTER.mongodb.net/?appName=Incubein

# Google OAuth 2.0 (Google Meet scheduling). In production GOOGLE_REDIRECT_URI
# must be the public URL: https://your-domain/api/outreach/oauth2callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-domain/api/outreach/oauth2callback

# Encryption key used for sensitive fields (any single value from dev .env).
ENCRYPTION_KEY=

# Redis connection (override if Redis is remote). Docker compose sets this
# automatically to the `redis` service.
REDIS_URL=redis://redis:6379/0
